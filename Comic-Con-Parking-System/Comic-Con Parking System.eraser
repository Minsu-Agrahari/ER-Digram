colorMode bold
// Stores Vehicle Type: Bike || Car || SUV || EV || Cab
VehicleCategory [icon: type, color: yellow] {
    vehicle_category_id INT pk
    category_name VARCHAR
    issue_time DATETIME
    updateAt DATETIME
  }
  
  // Vehicle details: per Vehicle info
  Vehicle [icon: car-taxi-front, color: blue] {
    vehicle_id INT pk
    vehicle_number VARCHAR
    owner_name VARCHAR
    vehicle_category_id INT fk
    issue_time DATETIME
    updateAt DATETIME
  }
  
  // Access Category: VIP || Staff || Exhibitor || Cosplayer || EV Charging
  AccessCategory [icon: key-square, color: yellow] {
    access_category_id INT pk
    category_name VARCHAR
    description TEXT
    issue_time DATETIME
    updateAt DATETIME
  }
  
  // Parking area devision: Zone1 || Zone2 || VIP Deck || Basement B2
  ParkingZone [icon: parking, color:blue] {
    zone_id INT pk
    zone_name VARCHAR
    level_number INT
    description TEXT
    issue_time DATETIME
    updateAt DATETIME
  }
  
  // Spot Type: Bike Spot || Car Spot || EV Spot
  ParkingSpotCategory [icon: home, color: yellow] {
    spot_id INT pk
    category_name VARCHAR
    issue_time DATETIME
    updateAt DATETIME
  }
  
  ParkingSpot [icon: road, color:blue] {
    spot_id INT pk
    spot_number VARCHAR 
    zone_id INT fk
    spot_category_id INT fk
    access_category_id INT (fk, null)
    is_available BOOLEAN
    issue_time DATETIME
    updateAt DATETIME
  }
  
  // Generated when vehicle enters: [Active, Closed, Lost]
  ParkingTicket [icon: ticket, color:green] {
    ticket_id INT pk 
    ticket_number VARCHAR
    status VARCHAR
    issue_time DATETIME
    updateAt DATETIME
  }
  
  // Tracks entry + exit : [Active, Completed]
  ParkingSession [icon: timer, color: green] {
    session_id INT pk
    vehicle_id INT fk
    spot_id INT fk
    ticket_id INT fk
    entry_time DATETIME
    exit_time DATETIME
    parking_fee DECIMAL
    session_status VARCHAR
  }
  
  Payment [icon: money, color: red] {
    payment_id INT pk
    session_id INT fk
    amount DECIMAL
    payment_method VARCHAR
    payment_status VARCHAR
    payment_time DATETIME
  }
  
  // Relations
  VehicleCategory.vehicle_category_id < Vehicle.vehicle_category_id

ParkingZone.zone_id < ParkingSpot.zone_id

ParkingSpotCategory.spot_category_id < ParkingSpot.spot_category_id

AccessCategory.access_category_id < ParkingSpot.access_category_id

Vehicle.vehicle_id < ParkingSession.vehicle_id

ParkingSpot.spot_id < ParkingSession.spot_id

ParkingTicket.ticket_id - ParkingSession.ticket_id

ParkingSession.session_id - Payment.session_id